# Copy to agent/.env (adk web reads it) or export before ./agent/deploy.sh
GOOGLE_API_KEY=                 # aistudio.google.com → Get API key (free tier, no card)
# or, instead of the key:
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
CORTEX_URL=http://127.0.0.1:8788     # the Cortex server the agent drives (public URL when deployed)
GRAFANA_URL=                          # https://<stack>.grafana.net → enables the Grafana Cloud MCP toolset (OAuth on first use)
